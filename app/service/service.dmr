# DMOD Resource File for dmsystem
# This file specifies where resources should be installed

# === Core Module ===
# Main module file - always installed
dmf=./${module}.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/${module}.dmf]

# Compressed module
dmfc=./${module}.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/${module}.dmfc]

# Dependencies file (if exists)
dmd=./${module}.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/${module}.dmd]

# Version information
version=./${module}_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/${module}_version.txt]

# === Documentation ===
# Module documentation in markdown format for dmf-man tool
# NOTE: ${repo_dir} is the top-level dmsystem repo root (CMAKE_SOURCE_DIR),
# not this module's own directory - service is built via add_subdirectory()
# from dmsystem's top-level CMakeLists.txt, so module-specific resources must
# be given relative to the repo root (see tools/tty/tty.dmr in dmtty for the
# same pattern). README.md/LICENSE are shared at the repo root, so those two
# stay unprefixed.
docs=./docs => ${destination}/${module}/docs [origin=${repo_dir}/app/service/docs]

# README file
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/README.md]

# === Header Files ===
# Include directory with all headers (public header + generated <module>_defs.h)
# NOTE: ${build_dir} is likewise the top-level CMAKE_BINARY_DIR, not this
# module's own CMAKE_CURRENT_BINARY_DIR - dmod_create_module() generates
# <module>_defs.h next to the module's own CMakeLists.txt (mirroring the
# source tree, i.e. ${build_dir}/app/service/), not at the build root.
inc=./include => ${destination}/${module}/include [origin=${repo_dir}/app/service/include] [origin=${build_dir}/app/service/${module}_defs.h]

# === License ===
# License file
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./${module}.dmr => ${destination}/${module}/${module}.dmr [origin=${repo_dir}/app/service/${module}.dmr]
